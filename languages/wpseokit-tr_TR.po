#: src/includes/Services/RedirectService.php
msgid "The new address must be a path on this site or a full http(s) address."
msgstr "Yeni adres bu sitede bir yol ya da tam bir http(s) adresi olmalı."

#: src/includes/Services/RedirectService.php
msgid "The old address must be a path on this site, such as /old-page/."
msgstr "Eski adres bu sitede bir yol olmalı; örneğin /old-page/."

#: src/includes/Services/RedirectService.php
msgid "The old and the new address are the same page. That is a loop."
msgstr "Eski ve yeni adres aynı sayfa. Bu bir döngü."

#: src/includes/Services/RedirectService.php
msgid "The redirect could not be saved."
msgstr "Yönlendirme kaydedilemedi."

#: src/includes/Services/RedirectService.php
