#: src/includes/Services/RedirectService.php
msgid "This site uses HTTPS. Do not redirect to an HTTP address."
msgstr "Bu site HTTPS kullanıyor. HTTP adresine yönlendirmeyin."

#: src/includes/Services/RedirectService.php
msgid "Use 301, 302, 307 or 410."
msgstr "301, 302, 307 ya da 410 kullanın."

#: src/includes/Services/RedirectService.php
