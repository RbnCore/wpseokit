msgstr "Bazı ayarların türü yanlış."

#: src/includes/Updater.php
msgid "Update rejected: signature verification (sodium) is missing on the server. The old version was kept."
msgstr "Güncelleme reddedildi: sunucuda imza doğrulaması (sodium) yok. Eski sürüm korundu."

#: src/includes/Updater.php
msgid "Update rejected: the plugin has no valid signature key. The old version was kept."
msgstr "Güncelleme reddedildi: eklentide geçerli bir imza anahtarı yok. Eski sürüm korundu."

#: src/includes/Updater.php
msgid "Update rejected: the package signature is invalid. The old version was kept."
msgstr "Güncelleme reddedildi: paket imzası geçersiz. Eski sürüm korundu."

#: src/includes/Updater.php
msgid "Update rejected: the package size is not in the expected range. The old version was kept."
msgstr "Güncelleme reddedildi: paket boyutu beklenen aralıkta değil. Eski sürüm korundu."

#: src/includes/Updater.php
msgid "Update rejected: the digest (SHA-256) file could not be read. The old version was kept."
msgstr "Güncelleme reddedildi: özet (SHA-256) dosyası okunamadı. Eski sürüm korundu."

#: src/includes/Updater.php
msgid "Update rejected: the SHA-256 digest of the package does not match. The old version was kept."
msgstr "Güncelleme reddedildi: paketin SHA-256 özeti eşleşmiyor. Eski sürüm korundu."

#: src/includes/Updater.php
msgid "Update rejected: the root folder of the package is not “wpseokit” or wpseokit.php is missing. The old version was kept."
msgstr "Güncelleme reddedildi: paketin kök klasörü “wpseokit” değil ya da wpseokit.php eksik. Eski sürüm korundu."

#: src/includes/Updater.php
msgid "Update rejected: the version inside the package does not match the published version. The old version was kept."
msgstr "Güncelleme reddedildi: paketin içindeki sürüm yayınlanan sürümle eşleşmiyor. Eski sürüm korundu."

#: src/includes/Updater.php
msgid "SEO titles and meta descriptions, canonical and robots, Open Graph, XML sitemap, schema graph, redirects and a 404 log."
msgstr "SEO başlıkları ve meta açıklamaları, kanonik ve robots, Open Graph, XML site haritası, şema grafiği, yönlendirmeler ve 404 kaydı."

#: src/includes/Updater.php
msgid "There are no release notes for this version."
msgstr "Bu sürüm için sürüm notu yok."

#: src/includes/Updater.php
msgid "Update rejected: the package address is not in the expected format. The old version was kept."
msgstr "Güncelleme reddedildi: paket adresi beklenen biçimde değil. Eski sürüm korundu."

#: src/includes/Updater.php
msgid "Update stopped: the digest or signature file could not be downloaded. The old version was kept."
msgstr "Güncelleme durduruldu: özet ya da imza dosyası indirilemedi. Eski sürüm korundu."

#: src/includes/Updater.php
msgid "Update rejected: the package did not pass the WPSeoKit verification. The old version was kept."
msgstr "Güncelleme reddedildi: paket WPSeoKit doğrulamasından geçmedi. Eski sürüm korundu."

#: src/includes/Updater.php
msgid "You do not have permission for this action."
msgstr "Bu işlem için yetkiniz yok."

#: src/includes/Updater.php
msgid "The update check is off; GitHub is never contacted."
msgstr "Güncelleme denetimi kapalı; GitHub'a hiç bağlanılmaz."

#: src/includes/Updater.php
msgid "Not checked yet."
msgstr "Henüz denetlenmedi."

#: src/includes/Updater.php
msgid "There is no published version yet."
msgstr "Henüz yayınlanmış bir sürüm yok."

#: src/includes/Updater.php
msgid "Could not check; it will be tried again later. The plugin works normally."
msgstr "Denetlenemedi; daha sonra yeniden denenecek. Eklenti normal çalışır."

#: src/includes/Updater.php
#, php-format
msgid "A new version is available: %s. Click “Update” on the Plugins page."
msgstr "Yeni sürüm var: %s. Eklentiler sayfasında “Güncelle”ye tıklayın."

#: src/includes/Updater.php
msgid "The plugin is up to date."
msgstr "Eklenti güncel."

#: src/includes/Updater.php
msgid "never"
msgstr "hiç"

#: src/includes/Updater.php
msgid "Installed version"
msgstr "Kurulu sürüm"

#: src/includes/Updater.php
msgid "Last check"
msgstr "Son denetim"

#: src/includes/Updater.php
msgid "Automatic updates"
msgstr "Otomatik güncellemeler"

#: src/includes/Updater.php
msgid "Turned on or off with the “Enable auto-updates” link on the WPSeoKit row in the Plugins page."
msgstr "Eklentiler sayfasında WPSeoKit satırındaki “Otomatik güncellemeleri etkinleştir” bağlantısıyla açılır ya da kapatılır."

#: src/includes/Updater.php
msgid "The update package is verified with its SHA-256 digest and Ed25519 signature before installation; a package that cannot be verified is not installed. Only a standard GET request is sent; your site address or user information is not sent."
msgstr "Güncelleme paketi kurulmadan önce SHA-256 özeti ve Ed25519 imzasıyla doğrulanır; doğrulanamayan paket kurulmaz. Yalnız standart bir GET isteği gönderilir; site adresiniz ya da kullanıcı bilgileriniz gönderilmez."

#: src/includes/Updater.php
msgid "Check now"
msgstr "Şimdi denetle"

#: src/includes/Updater.php
msgid "Turn off the update check"
msgstr "Güncelleme denetimini kapat"

#: src/includes/Updater.php
msgid "Turn on the update check"
msgstr "Güncelleme denetimini aç"

